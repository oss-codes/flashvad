---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

const title = "FlashVAD — macOS benchmark report";
const description =
  "Test the FlashVAD research checkpoint locally and inspect measured macOS runtime, integrations, and explicit evaluation limits.";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FlashVAD — low-latency streaming VAD research" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="FlashVAD — low-latency streaming VAD research" />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to results</a>
    <div class="site-shell">
      <SiteHeader />
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>
